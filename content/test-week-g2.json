  "weeks": [
    {
      "skill": "a / an / the and there is / are",
      "opensOn": "2026-11-26",
      "lessons": [
        {
          "title": "A or an?",
          "questions": [
            { "type": "pick_one", "skill": "articles", "prompt": "Pick the right sentence.", "choices": ["Ben found a ant in his bag.", "Ben found an ant in his bag.", "Ben found ant in his bag."], "answer": 1 },
            { "type": "pick_one", "skill": "articles", "prompt": "Pick the right sentence.", "choices": ["Leo has a old bike.", "Leo has old bike.", "Leo has an old bike."], "answer": 2 },
            { "type": "pick_one", "skill": "articles", "prompt": "Which sentence is right?", "choices": ["Mom gave me a big apple.", "Mom gave me an big apple.", "Mom gave me big apple."], "answer": 0 },
            { "type": "fill_blank", "skill": "articles", "before": "I see", "after": "owl in the tree.", "choices": ["a", "an", "two"], "answer": 1 },
            { "type": "fill_blank", "skill": "articles", "before": "My dad drives", "after": "red car.", "choices": ["a", "an", "two"], "answer": 0 },
            { "type": "fill_blank", "skill": "articles", "before": "This is", "after": "easy game.", "choices": ["two", "a", "an"], "answer": 2 },
            { "type": "find_fix", "skill": "articles", "words": ["Tom", "ate", "a", "apple."], "wrongIndex": 2, "fixes": ["two", "an", "many"], "answer": 1 },
            { "type": "find_fix", "skill": "articles", "words": ["Leo", "wants", "a", "orange."], "wrongIndex": 2, "fixes": ["an", "two", "many"], "answer": 0 },
            { "type": "find_fix", "skill": "articles", "words": ["Sam", "has", "umbrella."], "wrongIndex": 2, "fixes": ["a umbrella.", "an umbrella.", "two umbrella."], "answer": 1 },
            { "type": "build_it", "skill": "articles", "prompt": "Build the sentence.", "tiles": ["I", "ate", "an", "apple", "for", "lunch."], "distractors": ["a"] },
            { "type": "build_it", "skill": "articles", "prompt": "Build the sentence.", "tiles": ["Ben", "drew", "an", "elephant", "today."], "distractors": ["a"] },
            { "type": "sort_it", "skill": "articles", "prompt": "Sort the words.", "groups": ["a", "an"], "items": [
              { "text": "egg", "group": 1 },
              { "text": "banana", "group": 0 },
              { "text": "igloo", "group": 1 },
              { "text": "cup", "group": 0 },
              { "text": "uncle", "group": 1 },
              { "text": "horse", "group": 0 }
            ] }
          ]
        },
        {
          "title": "A, an, or the?",
          "questions": [
