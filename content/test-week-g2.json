            { "type": "pick_one", "skill": "articles", "prompt": "Which sentence is right?", "choices": ["The sky is blue today.", "Sky is blue today.", "A sky is blue today."], "answer": 0 },
            { "type": "pick_one", "skill": "articles", "prompt": "Pick the right sentence.", "choices": ["We played with boring computer.", "We played with an boring computer.", "We played with a boring computer."], "answer": 2 },
            { "type": "fill_blank", "skill": "articles", "before": "I have a dog.", "after": "dog is brown.", "choices": ["An", "The", "Two"], "answer": 1 },
            { "type": "fill_blank", "skill": "articles", "before": "Mia is reading", "after": "book about frogs.", "choices": ["an", "a", "many"], "answer": 1 },
            { "type": "fill_blank", "skill": "articles", "before": "At night, we can see", "after": "moon.", "choices": ["the", "an", "many"], "answer": 0 },
            { "type": "find_fix", "skill": "articles", "words": ["Mina", "spilled", "cup", "of", "milk."], "wrongIndex": 2, "fixes": ["a cup", "an cup", "two cup"], "answer": 0 },
            { "type": "find_fix", "skill": "articles", "words": ["Ben", "sat", "on", "chair."], "wrongIndex": 3, "fixes": ["an chair.", "a chair.", "two chair."], "answer": 1 },
            { "type": "find_fix", "skill": "articles", "words": ["Tom", "is", "eating", "a", "banana", "in", "kitchen."], "wrongIndex": 6, "fixes": ["two kitchen.", "an kitchen.", "the kitchen."], "answer": 2 },
            { "type": "build_it", "skill": "articles", "prompt": "Build the sentence.", "tiles": ["The", "sun", "is", "very", "hot", "today."], "distractors": ["A"] },
            { "type": "build_it", "skill": "articles", "prompt": "Build the sentence.", "tiles": ["We", "played", "with", "a", "new", "computer."], "distractors": ["an"] },
            { "type": "sort_it", "skill": "articles", "prompt": "Right or wrong?", "groups": ["Right", "Wrong"], "items": [
              { "text": "an old hat", "group": 0 },
